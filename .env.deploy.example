# FTP settings for `pnpm site:deploy` (promo site → https://krocon.de/products/sonic-lab/).
# Copy to .env.deploy in the repository root – that file is git-ignored. Never commit credentials:
# this repository is public.

SITE_FTP_HOST=
SITE_FTP_USER=
# Leave empty to be asked (hidden) on every deploy.
SITE_FTP_PASSWORD=
# Remote folder that the web server publishes as /products/sonic-lab/ – absolute, or relative to
# the FTP login folder.
SITE_FTP_DIR=
SITE_FTP_PORT=21
# true = FTPS with explicit TLS (recommended), implicit, or false = plain FTP (unencrypted).
SITE_FTP_SECURE=true
