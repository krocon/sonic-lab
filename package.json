{
  "name": "audiolab",
  "version": "0.1.0",
  "description": "Local, privacy-first audio signal analyzer (web + Tauri 2 desktop)",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": "^22.22.0 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "node scripts/build-worklets.mjs && ng serve",
    "dev": "pnpm start",
    "build": "node scripts/build-worklets.mjs && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "node scripts/build-worklets.mjs && ng test --watch=false",
    "test:watch": "ng test",
    "lint": "ng lint && tsc -p src/worklets/tsconfig.json",
    "format": "prettier --write \"src/**/*.{ts,html,css}\" \"e2e/**/*.ts\" \"*.{json,md}\" \"docs/**/*.md\" \"prompts/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\" \"e2e/**/*.ts\"",
    "e2e": "playwright test --project=chromium",
    "e2e:install": "playwright install chromium firefox webkit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:mac": "tauri build --target universal-apple-darwin --bundles app,dmg",
    "tauri:build:linux": "tauri build --bundles deb,rpm,appimage",
    "tauri:build:windows": "tauri build --bundles msi,nsis",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "rust:lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "pnpm version:check && pnpm scripts:test && pnpm format:check && pnpm lint && pnpm test && pnpm build && pnpm rust:fmt && pnpm rust:lint && pnpm rust:test",
    "worklets": "node scripts/build-worklets.mjs",
    "typecheck:worklets": "tsc -p src/worklets/tsconfig.json",
    "test:coverage": "node scripts/build-worklets.mjs && ng test --watch=false --configuration coverage",
    "e2e:all": "playwright test --workers=2",
    "test:signals": "node scripts/build-worklets.mjs && ng test --watch=false --include=src/app/decoders/morse/robustness.spec.ts",
    "version:check": "node scripts/version.mjs check",
    "version:set": "node scripts/version.mjs set",
    "release:prepare": "node scripts/version.mjs prepare",
    "release:notes": "node scripts/release-notes.mjs",
    "scripts:test": "node --test \"scripts/*.test.mjs\""
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@tauri-apps/api": "2.12.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.6.0",
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.4",
    "@vitest/coverage-v8": "5.1.0",
    "angular-eslint": "22.6.0",
    "esbuild": "0.28.2",
    "eslint": "^10.14.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "^5.0.0"
  }
}
