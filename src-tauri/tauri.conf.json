{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Sonic Lab",
  "version": "../package.json",
  "identifier": "io.github.krocon.audiolab",
  "build": {
    "frontendDist": "../dist/audiolab/browser",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm start",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sonic Lab",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob: mediastream:; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost",
      "devCsp": null,
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "publisher": "Marc Kronberg",
    "copyright": "© 2026 Marc Kronberg",
    "targets": [
      "app",
      "dmg",
      "deb",
      "rpm",
      "appimage",
      "msi",
      "nsis"
    ],
    "category": "Utility",
    "shortDescription": "Local audio signal analyzer",
    "longDescription": "Sonic Lab records, visualises and analyses audio in real time – fully on your device. Its first module decodes acoustic Morse code.",
    "homepage": "https://github.com/krocon/sonic-lab",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "./Entitlements.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
